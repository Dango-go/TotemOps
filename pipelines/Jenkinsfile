pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    role: jenkins-agent
spec:
  containers:
  - name: gitleaks
    image: zricethezav/gitleaks:latest
    command: ['cat']
    tty: true
  - name: semgrep
    image: semgrep/semgrep:latest
    command: ['cat']
    tty: true
  - name: trivy
    image: aquasec/trivy:latest
    command: ['cat']
    tty: true
  - name: python
    image: python:3.12-slim
    command: ['cat']
    tty: true
  - name: kaniko
    image: gcr.io/kaniko-project/executor:debug
    command: ['cat']
    tty: true
  - name: kustomize
    image: registry.k8s.io/kustomize/kustomize:v5.4.1
    command: ['cat']
    tty: true
'''
        }
    }

    environment {
        REGISTRY_HOST         = '123456789012.dkr.ecr.eu-central-1.amazonaws.com'
        REGISTRY_PROJECT      = ''
        SCAN_EXIT_CODE        = '1'
        CHANGED_SERVICES      = ''
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '15'))
        timeout(time: 2, unit: 'HOURS')
        ansiColor('xterm')
        disableConcurrentBuilds()
    }

    stages {
        stage('1. Checkout & Detect Changes') {
            steps {
                echo '==> Getting source code from Git...'
                checkout scm

                script {
                    echo '==> Detecting changed services...'
                    def changedFiles = sh(
                        script: 'git diff --name-only HEAD~1 HEAD || true',
                        returnStdout: true
                    ).trim().split('\n')

                    def servicesList = []
                    for (file in changedFiles) {
                        if (file.startsWith('services/')) {
                            def parts = file.split('/')
                            if (parts.length > 1) {
                                def serviceName = parts[1]
                                if (!servicesList.contains(serviceName)) {
                                    servicesList.add(serviceName)
                                }
                            }
                        }
                    }

                    env.CHANGED_SERVICES = servicesList.join(',')
                    echo "==> Saved services for the next stages: ${env.CHANGED_SERVICES}"
                }
            }
        }

        stage('2. Source Code & Secret Security') {
            parallel {
                stage('Gitleaks (Secret Detection)') {
                    steps {
                        container('gitleaks') {
                            echo '==> Checking for hardcoded secrets...'
                            sh 'gitleaks detect --source=. --verbose --exit-code=1'
                        }
                    }
                }
                stage('Semgrep (SAST)') {
                    steps {
                        container('semgrep') {
                            echo '==> Static Application Security Testing (SAST)...'
                            sh 'semgrep --config=auto --error'
                        }
                    }
                }
            }
        }

        stage('3. Supply Chain & Dependencies (SCA)') {
            steps {
                container('trivy') {
                    echo '==> Scanning dependencies for known CVEs (Trivy FS)...'
                    sh "trivy fs --security-checks vuln --severity HIGH,CRITICAL --exit-code ${SCAN_EXIT_CODE} ."
                }
            }
        }

        stage('4. Build & Unit Tests') {
            steps {
                container('python') {
                    echo '==> Running Python unit tests for changed services...'
                    script {
                        def targets = env.CHANGED_SERVICES ? env.CHANGED_SERVICES.split(',') : []
                        if (targets.size() == 0) {
                            echo 'No services changed. Skipping unit tests.'
                        } else {
                            for (service in targets) {
                                echo "--> Testing service: ${service}"
                                dir("services/${service}") {
                                    sh 'pip install --no-cache-dir -r requirements.txt || true'
                                    sh 'pytest --junitxml=results.xml || true'
                                }
                            }
                        }
                    }
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResultsPatterns: '**/results.xml'
                }
            }
        }

        stage('5. Containerization (Kaniko) in ECR') {
            steps {
                container('kaniko') {
                    echo '==> Building container images...'
                    script {
                        def targets = env.CHANGED_SERVICES ? env.CHANGED_SERVICES.split(',') : []
                        if (targets.size() == 0) {
                            echo 'No services changed. Skipping container build.'
                        } else {
                            for (service in targets) {
                                def imageTag = "${env.REGISTRY_HOST}/${service}:${env.BUILD_NUMBER}"
                                echo "--> Building Docker image for ${service}: ${imageTag}"
                                sh """
                                /kaniko/executor \
                                  --context=dir://services/${service} \
                                  --dockerfile=services/${service}/Dockerfile \
                                  --destination=${imageTag} \
                                  --no-push
                                """
                            }
                        }
                    }
                }
            }
        }

        stage('6. Container Security (Trivy Image Scan)') {
            steps {
                container('trivy') {
                    echo '==> Scanning built container images for vulnerabilities...'
                    script {
                        def targets = env.CHANGED_SERVICES ? env.CHANGED_SERVICES.split(',') : []
                        for (service in targets) {
                            def imageTag = "${env.REGISTRY_HOST}/${service}:${env.BUILD_NUMBER}"
                            echo "--> Scanning image: ${imageTag}"
                            sh "trivy image --severity HIGH,CRITICAL --exit-code ${SCAN_EXIT_CODE} ${imageTag} || true"
                        }
                    }
                }
            }
        }

        stage('7. GitOps Handover (ArgoCD Sync Trigger) for apps') {
            steps {
                echo '==> Updating image tags in GitOps manifests...'
                script {
                    def targets = env.CHANGED_SERVICES ? env.CHANGED_SERVICES.split(',') : []
                    if (targets.size() == 0) {
                        echo 'No services changed. Skipping GitOps update.'
                    } else {
                        container('kustomize') {
                            dir('cluster/apps/overlays/stage') {
                                for (service in targets) {
                                    def fullImage = "${env.REGISTRY_HOST}/${service}:${env.BUILD_NUMBER}"
                                    echo "--> Kustomize edit set image for ${service}: ${fullImage}"
                                    sh "kustomize edit set image ${service}=${fullImage}"
                                }
                            }
                        }

                        sh """
                            git config --global user.name "Jenkins CI Bot"
                            git config --global user.email "jenkins-ci@totemops.internal"
                            git add cluster/apps/overlays/stage/kustomization.yaml
                            git diff --staged --quiet || git commit -m "ci(gitops): update image tags to build #${env.BUILD_NUMBER} [skip ci]"
                            # git push origin main
                        """
                        echo "✅ GitOps manifest updated and ready for ArgoCD sync!"
                    }
                }
            }
        }
    }

    post {
        success {
            echo '✅ DevSecOps CI pipeline completed successfully! ArgoCD can sync.'
        }
        failure {
            echo '❌ Pipeline failed! Security vulnerability, test failure, or build issue detected.'
        }
        always {
            echo '🧹 Build workspace completed.'
        }
    }
}