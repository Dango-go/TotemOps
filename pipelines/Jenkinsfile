pipeline {
    agent {
    kubernetes {
        yaml '''
    apiVersion: v1
    kind: Pod
    metadata:
    labels:
        some-label: build-agent
    spec:
    containers:
    - name: gitleaks
      image: zricethezav/gitleaks:latest
      command: ['cat']
      tty: true
    - name: semgrep
      image: semgrep/semgrep:latest
      command: ['cat']
      tty: true
    - name: trivy
      image: aquasec/trivy:latest
      command: ['cat']
      tty: true
    - name: python
      image: python:3.12-slim
      command: ['cat']
      tty: true
    '''
        }
}     


    environment {  
        DOCKER_REGISTRY_CREDS = credentials('docker-hub-credentials-id')
        GITLAB_SSH_CREDS      = credentials('gitlab-ssh-deploy-key-id')
        IMAGE_NAME            = 'your-registry.io/your-project/my-app'

        SCAN_EXIT_CODE        = '1'  
        TRIVY_SECURITY_CHECKS = 'vuln,config,secret'
        CHANGED_SERVICES      = ''
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '15'))
        timeout(time: 2, unit: 'HOURS')
        ansiColor('xterm')
        disableConcurrentBuilds() // Disable concurrent builds for the same branch
    }

    stages {
        stage('1. Checkout Code and git diff') {
            steps {
                container('gitleaks') {
                    echo '==> Get source code...'
                    checkout scm
                    
                    script {
                        echo '==> Detecting changed services...' 
                    def changedFiles = sh(script: 'git diff --name-only HEAD~1 HEAD', returnStdout: true).trim().split('\n') // paths returned in String, later in list of paths
                    env.CHANGED_SERVICES = ''
                    
                    def servicesList = []

                    for (file in changedFiles) {
                        if (file.startsWith('services/')) {
                            def serviceName = file.split('/')[1] // added name of service
                            if (!servicesList.contains(serviceName)) {
                                servicesList.add(serviceName)
                            }
                        }  
                    }
                    env.CHANGED_SERVICES = servicesList.join(',') // Join the list into a comma-separated string
                    echo "==> Saved services for the next stages: ${env.CHANGED_SERVICES}"    
                    }
                }
            }
        }

        stage('2. Source Code & Secret Security') {
            
            parallel {
                stage('Gitleaks (Secret Detection)') {
                    steps {
                        echo '==> Check for hardcoded secrets...'
                        sh 'gitleaks detect --source=. --verbose --exit-code=1'
                    }
                }
                stage('Semgrep (SAST)') {
                    steps {
                        echo '==> Static Analysis (SAST)...'
                        sh 'semgrep --config=auto --error'
                    }
                }
            }
        }

        stage('3. Supply Chain & Dependencies (SCA)') {
            steps {
                echo '==> Scan dependencies (Trivy FS)...'
                sh "trivy fs --security-checks vuln --severity HIGH,CRITICAL --exit-code ${SCAN_EXIT_CODE} ."
            }
        }

        stage('4. Build & Unit Tests') {
            steps {
                echo '==> Build & Unit Tests...'
                sh ''
            }
            post {
                always {
                    // Збереження результатів тестів
                    junit allowEmptyResults: true, testResultsPatterns: '**/surefire-reports/*.xml,**/test-results/*.xml'
                }
            }
        }

        stage('5. Containerization (Docker Build)') {
            steps {
                echo '==> Build Docker image...'
                script {
                    appImage = docker.build("${IMAGE_NAME}:${env.BUILD_NUMBER}", "--build-arg BUILD_VERSION=${env.BUILD_NUMBER} .")
                }
            }
        }

        stage('6. Container Security (Trivy Image & Config)') {
            steps {
                echo '==> Scan Docker image...'
                sh "trivy image --severity HIGH,CRITICAL --exit-code ${SCAN_EXIT_CODE} ${IMAGE_NAME}:${env.BUILD_NUMBER}"
            }
        }

        stage('7. Push to Secure Registry') {
            steps {
                echo '==> Push to Secure Registry...'
                script {
                    docker.withRegistry('https://registry.io', 'DOCKER_REGISTRY_CREDS') {
                        appImage.push()
                        appImage.push('latest')
                    }
                }
            }
        }

        stage('8. GitOps Handover (ArgoCD Integration)') {
            steps {
                echo '==> Update image version in GitOps repository for ArgoCD...'
                script {
                    sshagent(['GITLAB_SSH_CREDS']) {
                        sh """
                            git config --global user.name "Jenkins CI Bot"
                            git config --global user.email "jenkins-ci@your-company.com"
                            
                            # Клонуємо репозиторій з Kubernetes-маніфестами (або Helm-значеннями)
                            git clone git@gitlab.com:your-org/k8s-gitops-manifests.git gitops-repo
                            cd gitops-repo
                            
                            # Оновлюємо тег образу у відповідному файлі (наприклад, за допомогою yq або sed)
                            # Приклад для kustomize або plain yaml:
                            sed -i 's|image: ${IMAGE_NAME}:.*|image: ${IMAGE_NAME}:${env.BUILD_NUMBER}|g' apps/production/deployment.yaml
                            
                            git add .
                            git commit -m "CI: Update image tag to ${env.BUILD_NUMBER} [skip ci]"
                            git push origin main
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo '✅ DevSecOps CI конвеєр успішно завершено! ArgoCD автоматично підхопить зміни у Git.'
        }
        failure {
            echo '❌ УВАГА: Білд зупинено через виявлення вразливостей безпеки, помилки компіляції або тестів!'
            // Тут можна додати відправку сповіщень у Slack / Telegram / Jira
        }
        always {
            echo '🧹 Очищення робочого простору...'
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
    }
}